{
  "name": "Prof Greg Content Design System",
  "version": "0.1.0",
  "brand": {
    "identity": "BuildStak",
    "logos": {
      "wordmark": "workspace/assets/logos/buildstak-wordmark.png",
      "wordmark_negative": "workspace/assets/logos/buildstak-wordmark-negative.png",
      "icon": "workspace/assets/logos/buildstak-icon.png"
    }
  },
  "principles": {
    "primary": "Form follows function.",
    "tone": "Academic, practical, clear, and construction-native.",
    "audience": "Residential construction workers and construction professionals in the United States, including American-born and immigrant workers.",
    "sector_anchor": "Residential construction first; commercial examples only when needed as contrast or concept support.",
    "source_language": "English"
  },
  "colors": {
    "navy_primary": "#2C4363",
    "orange_accent": "#F37021",
    "white_base": "#FFFFFF",
    "gray_section": "#F5F7FA",
    "gray_neutral": "#F0F0F0",
    "gray_body": "#4A4A4A",
    "gray_caption": "#8A8A8A",
    "chart_blue_1": "#5B7BA8",
    "chart_blue_2": "#8FA9C9",
    "chart_orange_light": "#F8A668",
    "chart_gray": "#A8A8A8"
  },
  "typography": {
    "font_family_primary": "Arial",
    "font_family_fallback": "Helvetica",
    "body_line_spacing": 1.4,
    "docx": {
      "cover_h1": { "size_pt": 36, "min_pt": 32, "max_pt": 40, "weight": "bold", "color": "navy_primary" },
      "page_h1": { "size_pt": 21, "min_pt": 20, "max_pt": 22, "weight": "bold", "color": "navy_primary" },
      "section_h2": { "size_pt": 17, "min_pt": 16, "max_pt": 18, "weight": "bold", "color": "navy_primary" },
      "subsection_h3": { "size_pt": 13.5, "min_pt": 13, "max_pt": 14, "weight": "bold", "color": "navy_primary" },
      "body": { "size_pt": 11, "weight": "regular", "color": "gray_body" },
      "callout_body": { "size_pt": 11, "weight": "regular", "color": "gray_body" },
      "callout_label": { "size_pt": 11, "weight": "bold" },
      "figure_caption": { "size_pt": 10, "weight": "italic", "color": "gray_caption" },
      "footer": { "size_pt": 9, "weight": "regular", "color": "gray_caption" },
      "glossary_term": { "size_pt": 11, "weight": "bold", "color": "navy_primary" },
      "glossary_definition": { "size_pt": 11, "weight": "regular", "color": "gray_body" }
    },
    "visuals": {
      "chart_title": { "size_pt": 14, "weight": "bold", "color": "navy_primary" },
      "axis_labels": { "size_pt": 10, "weight": "regular", "color": "gray_body" },
      "tick_labels": { "size_pt": 9, "weight": "regular", "color": "gray_body" },
      "data_labels": { "size_pt": 10, "weight": "regular", "color": "gray_body" },
      "highlight_data_labels": { "size_pt": 10, "weight": "bold", "color": "orange_accent" },
      "node_labels": { "size_pt": 11, "weight": "regular", "color": "navy_primary" },
      "annotations": { "size_pt": 9, "weight": "italic", "color": "gray_caption" }
    },
    "pptx": {
      "slide_title": { "size_pt": 30, "weight": "bold", "color": "navy_primary" },
      "slide_section_label": { "size_pt": 12, "weight": "bold", "color": "orange_accent" },
      "slide_body": { "size_pt": 18, "weight": "regular", "color": "gray_body" },
      "slide_caption": { "size_pt": 11, "weight": "regular", "color": "gray_caption" },
      "slide_large_number": { "size_pt": 44, "weight": "bold", "color": "orange_accent" }
    }
  },
  "spacing": {
    "space_xs_px": 6,
    "space_sm_px": 12,
    "space_md_px": 24,
    "space_lg_px": 32,
    "space_xl_px": 48,
    "visual_outer_padding_px": 24,
    "visual_gap_px_min": 12,
    "visual_gap_px_max": 24,
    "visual_min_whitespace_ratio": 0.2
  },
  "chart_color_order": [
    "navy_primary",
    "chart_blue_1",
    "chart_blue_2",
    "chart_orange_light",
    "chart_gray"
  ],
  "callouts": {
    "apply_it": { "label": "APPLY IT", "accent": "orange_accent", "function": "Practical learner action." },
    "key_term": { "label": "KEY TERM", "accent": "navy_primary", "function": "Important vocabulary definition." },
    "hands_on_example": { "label": "HANDS-ON EXAMPLE", "accent": "gray_neutral", "function": "Worked practical example." },
    "scenario": { "label": "SCENARIO", "accent": "white_base", "function": "Applied situation or case moment." },
    "callback": { "label": "CALLBACK", "accent": "gray_caption", "function": "Connection to prior lesson." },
    "bridge": { "label": "BRIDGE", "accent": "orange_accent", "function": "Connection to future lesson." }
  }
}
