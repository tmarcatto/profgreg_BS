[Unit]
Description=Prof Greg private operator UI
After=network-online.target profgreg-worker.service
Wants=network-online.target
Documentation=file:/opt/profgreg/app/workspace/contracts/operator-interface-contract.md

[Service]
Type=simple
User=profgreg
Group=profgreg
WorkingDirectory=/opt/profgreg/app
EnvironmentFile=/etc/profgreg/profgreg.env
ExecStart=/usr/bin/python3 /opt/profgreg/app/tools/greg_ui_server.py --host 127.0.0.1 --port 8765 --job-root /srv/profgreg/jobs --course construction-schedule-management
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/profgreg/uploads /srv/profgreg/outputs /var/log/profgreg
ReadWritePaths=/srv/profgreg/jobs /srv/profgreg/backups /opt/profgreg/app/tmp

[Install]
WantedBy=multi-user.target
