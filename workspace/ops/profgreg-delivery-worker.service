[Unit]
Description=Prof Greg delivery job worker
After=network-online.target
Wants=network-online.target
Documentation=file:/opt/profgreg/app/workspace/contracts/server-job-contract.md

[Service]
Type=simple
User=profgreg
Group=profgreg
WorkingDirectory=/opt/profgreg/app
EnvironmentFile=/etc/profgreg/profgreg.env
ExecStart=/usr/bin/python3 /opt/profgreg/app/tools/greg_server_status.py --worker --worker-lane delivery --job-root /srv/profgreg/jobs --backup-root /srv/profgreg/backups --poll-interval 5
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/profgreg/uploads /srv/profgreg/outputs /var/log/profgreg
ReadWritePaths=/srv/profgreg/jobs /srv/profgreg/backups /opt/profgreg/app/tmp /opt/profgreg/app/runs

[Install]
WantedBy=multi-user.target
